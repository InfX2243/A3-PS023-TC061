# Copy to .env for local development; never commit .env or real secrets.
# Generate each secret independently: openssl rand -hex 32
VM_CONTROLLER_OPERATOR_TOKEN=REPLACE_WITH_A_LONG_RANDOM_API_AND_SESSION_SECRET
VM_CONTROLLER_OPERATOR_USERNAME=operator
VM_CONTROLLER_OPERATOR_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PASSWORD_OF_AT_LEAST_16_CHARACTERS
VM_CONTROLLER_WORKER_SHARED_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_WORKER_SECRET

# Keep the Go HTTP listener private; terminate TLS at a reverse proxy.
VM_CONTROLLER_LISTEN_ADDR=127.0.0.1:8080
VM_CONTROLLER_DATABASE_PATH=./data/controller.db
VM_CONTROLLER_MAX_VCPUS=8

# Optional AWS EC2 console integration. The controller uses the AWS SDK; no AWS CLI is needed here.
# Prefer an attached IAM role. For local testing, use standard AWS environment
# credentials or an AWS shared profile; never paste credentials into the UI.
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Production: set secure_cookies=true in /etc/aiori/config.json when served over HTTPS.

# Optional end-to-end EC2 worker bootstrap. Uncomment and replace every value.
# Artifact URLs must be immutable HTTPS URLs with no query string; verify the
# matching SHA-256 values before enabling this workflow.
# VM_CONTROLLER_PUBLIC_URL=
# VM_CONTROLLER_WORKER_AGENT_URL=
# VM_CONTROLLER_WORKER_AGENT_SHA256=
# VM_CONTROLLER_CLOUD_HYPERVISOR_URL=
# VM_CONTROLLER_CLOUD_HYPERVISOR_SHA256=
# VM_CONTROLLER_WORKER_KERNEL_URL=
# VM_CONTROLLER_WORKER_KERNEL_SHA256=
# VM_CONTROLLER_WORKER_DISK_URL=
# VM_CONTROLLER_WORKER_DISK_SHA256=
# VM_CONTROLLER_WORKER_SECRET_PARAMETER=/aiori/worker/shared-secret
# VM_CONTROLLER_WORKER_IMAGE_ID=ubuntu-demo
# VM_CONTROLLER_WORKER_MEMORY_LIMIT_MIB=4096
# VM_CONTROLLER_WORKER_AGENT_PORT=9090
# Must be the controller EC2 security group in the same VPC as worker nodes.
# Only this source security group is allowed to reach the worker-agent port.
# VM_CONTROLLER_SECURITY_GROUP_ID=
